#9. Store details of 5 students and display only those whose CGPA is greater than or equal to 8.0.

#include <stdio.h>

struct Student {
    int rollNumber;
    char name[50];
    float cgpa;
};

int main() {
    struct Student students[5];

    for (int i = 0; i < 5; i++) {
        printf("Enter Roll Number, Name, and CGPA for Student %d:\n", i + 1);
        scanf("%d", &students[i].rollNumber);
        scanf(" %[^\n]s", students[i].name);
        scanf("%f", &students[i].cgpa);
    }

    printf("\n--- Students with CGPA >= 8.0 ---\n");
    for (int i = 0; i < 5; i++) {
        if (students[i].cgpa >= 8.0) {
            printf("Roll Number: %d | Name: %s | CGPA: %.2f\n", students[i].rollNumber, students[i].name, students[i].cgpa);
        }
    }

    return 0;
}
