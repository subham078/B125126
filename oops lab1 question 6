#6. Create a structure containing Feet and Inches. Accept two distances and display the total. (Note: Instructed to ignore conversion if inches exceed 12)

#include <stdio.h>

struct Distance {
    int feet;
    int inches;
};

int main() {
    struct Distance d1, d2, total;

    printf("Enter Distance 1 (Feet Inches): ");
    scanf("%d %d", &d1.feet, &d1.inches);
    printf("Enter Distance 2 (Feet Inches): ");
    scanf("%d %d", &d2.feet, &d2.inches);

    total.feet = d1.feet + d2.feet;
    total.inches = d1.inches + d2.inches;

    printf("\nTotal Distance: %d feet %d inches\n", total.feet, total.inches);

    return 0;
}
