#3. Create a structure with Book ID, Title, Author Name, and Price, then display them neatly.

#include <stdio.h>

struct Book {
    int bookID;
    char title[100];
    char author[50];
    float price;
};

int main() {
    struct Book b1;

    printf("Enter Book ID: ");
    scanf("%d", &b1.bookID);
    printf("Enter Title: ");
    scanf(" %[^\n]s", b1.title);
    printf("Enter Author Name: ");
    scanf(" %[^\n]s", b1.author);
    printf("Enter Price: ");
    scanf("%f", &b1.price);

    printf("\n--- Book Information ---\n");
    printf("Book ID   : %d\n", b1.bookID);
    printf("Title     : %s\n", b1.title);
    printf("Author    : %s\n", b1.author);
    printf("Price     : $%.2f\n", b1.price);

    return 0;
}
